---
import '../styles/global.css';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Quản Trị Hệ Thống --- Game Tuổi Thơ', activeNav = 'dashboard' } = Astro.props;
---

<!doctype html>
<html lang="vi" class="dark" data-admin-pending>
  <head>
    <meta charset="UTF-8" />
    <!-- Hidden until the browser confirms an ADMIN session (second layer; the server gates /admin first). -->
    <style is:inline>html[data-admin-pending] body { visibility: hidden; }</style>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-arcade-950 text-slate-100 min-h-screen flex">
    <!-- Backdrop for the mobile admin menu -->
    <div id="admin-menu-backdrop" class="hidden fixed inset-0 z-40 bg-black/70 backdrop-blur-sm md:hidden" aria-hidden="true"></div>

    <!-- Admin Sidebar (static on md+, slide-in drawer on small screens) -->
    <aside id="admin-sidebar" class="w-64 max-w-[85vw] bg-arcade-900 border-r border-arcade-800 flex flex-col justify-between overflow-y-auto hidden md:flex md:static md:max-w-none md:shadow-none md:flex-shrink-0">
      <div>
        <!-- Admin header -->
        <div class="h-16 px-6 border-b border-arcade-800 flex items-center gap-3">
          <span class="text-2xl">⚡</span>
          <div>
            <h1 class="font-extrabold text-sm tracking-wider text-neon-pink">ADMIN PORTAL</h1>
            <p class="text-[10px] text-slate-500 font-mono">Game Tuổi Thơ Control Center</p>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="p-4 space-y-1">
          <a
            href="/admin"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              activeNav === 'dashboard'
                ? 'bg-neon-pink/20 text-neon-pink border border-neon-pink/40 shadow-sm'
                : 'text-slate-400 hover:text-slate-200 hover:bg-arcade-800'
            }`}
          >
            <span>📊</span>
            <span>Dashboard</span>
          </a>

          <a
            href="/admin/games"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              activeNav === 'games'
                ? 'bg-neon-pink/20 text-neon-pink border border-neon-pink/40 shadow-sm'
                : 'text-slate-400 hover:text-slate-200 hover:bg-arcade-800'
            }`}
          >
            <span>🎮</span>
            <span>Quản lý Game Catalog</span>
          </a>

          <a
            href="/admin/games/create"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              activeNav === 'create-game'
                ? 'bg-neon-pink/20 text-neon-pink border border-neon-pink/40 shadow-sm'
                : 'text-slate-400 hover:text-slate-200 hover:bg-arcade-800'
            }`}
          >
            <span>➕</span>
            <span>Thêm Game Mới</span>
          </a>

          <a
            href="/admin/categories"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              activeNav === 'categories'
                ? 'bg-neon-pink/20 text-neon-pink border border-neon-pink/40 shadow-sm'
                : 'text-slate-400 hover:text-slate-200 hover:bg-arcade-800'
            }`}
          >
            <span>🏷️</span>
            <span>Quản lý Thể Loại</span>
          </a>

          <a
            href="/admin/users"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              activeNav === 'users'
                ? 'bg-neon-pink/20 text-neon-pink border border-neon-pink/40 shadow-sm'
                : 'text-slate-400 hover:text-slate-200 hover:bg-arcade-800'
            }`}
          >
            <span>👥</span>
            <span>Quản Lý Người Dùng</span>
          </a>

          <a
            href="/admin/user-imports"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              activeNav === 'imports'
                ? 'bg-neon-pink/20 text-neon-pink border border-neon-pink/40 shadow-sm'
                : 'text-slate-400 hover:text-slate-200 hover:bg-arcade-800'
            }`}
          >
            <span>📥</span>
            <span>Game Người Dùng Tải Lên</span>
          </a>

          <a
            href="/admin/crawler"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              activeNav === 'crawler'
                ? 'bg-neon-pink/20 text-neon-pink border border-neon-pink/40 shadow-sm'
                : 'text-slate-400 hover:text-slate-200 hover:bg-arcade-800'
            }`}
          >
            <span>🕷️</span>
            <span>Nhập Game (gametuoitho.cc)</span>
          </a>

          <a
            href="/admin/reports"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              activeNav === 'reports'
                ? 'bg-neon-pink/20 text-neon-pink border border-neon-pink/40 shadow-sm'
                : 'text-slate-400 hover:text-slate-200 hover:bg-arcade-800'
            }`}
          >
            <span>🚨</span>
            <span>Báo Cáo & Log Lỗi</span>
          </a>

          <a
            href="/admin/storage"
            class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-all ${
              activeNav === 'storage'
                ? 'bg-neon-pink/20 text-neon-pink border border-neon-pink/40 shadow-sm'
                : 'text-slate-400 hover:text-slate-200 hover:bg-arcade-800'
            }`}
          >
            <span>🧹</span>
            <span>Quản Lý & Dọn Dẹp</span>
          </a>
        </nav>
      </div>

      <!-- Bottom User / Exit Link -->
      <div class="p-4 border-t border-arcade-800">
        <a
          href="/"
          class="flex items-center gap-2 text-xs text-slate-400 hover:text-neon-cyan transition-colors"
        >
          <span>←</span>
          <span>Quay lại trang người dùng</span>
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden min-w-0">
      <!-- Top header bar -->
      <header class="h-14 sm:h-16 bg-arcade-900 border-b border-arcade-800 px-3 sm:px-6 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 sm:gap-4 min-w-0">
          <button
            type="button"
            id="admin-menu-toggle"
            class="md:hidden flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-lg border border-arcade-700 bg-arcade-800 text-slate-200 hover:border-neon-pink hover:text-neon-pink transition-colors"
            aria-label="Mở menu quản trị"
            aria-expanded="false"
            aria-controls="admin-sidebar"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
          <h2 class="text-xs sm:text-sm font-bold text-slate-300 uppercase tracking-wider truncate" title={title}>{title}</h2>
        </div>

        <div class="flex items-center gap-3 flex-shrink-0">
          <a href="/" class="md:hidden text-neon-cyan font-bold text-xs whitespace-nowrap py-2">← Trang chủ</a>
          <span class="hidden sm:inline-block w-2 h-2 rounded-full bg-neon-green"></span>
          <span class="hidden sm:inline text-xs font-mono text-slate-400">ADMIN MODE</span>
        </div>
      </header>

      <!-- Content slot -->
      <main class="flex-1 overflow-y-auto p-3 sm:p-6 bg-arcade-950">
        <slot />
      </main>
    </div>
    <script>
      import { getCurrentUser } from '../lib/api';

      // Only an ADMIN account may see the admin UI. A 401 is redirected to /login by apiRequest.
      getCurrentUser().then((res) => {
        if (res.success && res.data?.role === 'ADMIN') {
          document.documentElement.removeAttribute('data-admin-pending');
        } else if (res.success) {
          window.location.replace('/403/');
        } else if (res.error?.code !== 'UNAUTHORIZED') {
          // API unreachable / server error: show the page so the errors are visible.
          document.documentElement.removeAttribute('data-admin-pending');
        }
      });
    </script>

    <script>
      const sidebar = document.getElementById('admin-sidebar');
      const toggle = document.getElementById('admin-menu-toggle');
      const backdrop = document.getElementById('admin-menu-backdrop');
      if (sidebar && toggle && backdrop) {
        const DRAWER = ['fixed', 'inset-y-0', 'left-0', 'z-50', 'shadow-2xl'];
        const setOpen = (open: boolean) => {
          sidebar.classList.toggle('hidden', !open);
          DRAWER.forEach((c) => sidebar.classList.toggle(c, open));
          backdrop.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Đóng menu quản trị' : 'Mở menu quản trị');
        };
        toggle.addEventListener('click', () => setOpen(sidebar.classList.contains('hidden')));
        backdrop.addEventListener('click', () => setOpen(false));
        sidebar.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a') && window.matchMedia('(max-width: 767px)').matches) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !backdrop.classList.contains('hidden')) {
            setOpen(false);
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>
