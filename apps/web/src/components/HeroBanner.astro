---
import HomeGamePreview from './HomeGamePreview';
import ninjaPreview from '../assets/ninja-school-3-screen.png';
---

<section class="relative overflow-hidden py-8 sm:py-12 lg:py-20 border-b border-arcade-800 bg-gradient-to-b from-arcade-950 via-arcade-900 to-arcade-950">
  <div class="absolute inset-0 scanlines pointer-events-none opacity-40"></div>

  <!-- Ambient light blobs -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-neon-cyan/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-neon-pink/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-neon-cyan/10 border border-neon-cyan/40 rounded-full text-neon-cyan text-xs font-mono font-semibold">
          <span class="w-2 h-2 rounded-full bg-neon-cyan animate-ping"></span>
          <span>SỐNG LẠI KÝ ỨC ĐIỆN THOẠI BÀN PHÍM</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
          Huyền Thoại <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan via-neon-yellow to-neon-pink text-glow-cyan">
            GAME JAVA ME
          </span>
          <br />Trở Lại Trình Duyệt!
        </h1>

        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Không cần cài đặt giả lập phức tạp! Thưởng thức lại trọn vẹn Ninja School, Diamond Rush, Bounce Tales, Avatar và hàng trăm tựa game tuổi thơ với âm thanh MIDI và bàn phím bấm kinh điển.
        </p>

        <form action="/games" method="GET" role="search" class="flex flex-col sm:flex-row gap-3 max-w-xl mx-auto lg:mx-0">
          <label for="home-game-search" class="sr-only">Tìm kiếm game</label>
          <input
            id="home-game-search"
            type="search"
            name="search"
            placeholder="Bạn muốn chơi game gì?"
            maxlength="200"
            class="min-w-0 flex-1 px-4 py-3 bg-arcade-800 border border-arcade-600 rounded-xl text-sm text-slate-100 placeholder:text-slate-500 focus:outline-none focus:border-neon-cyan focus:ring-2 focus:ring-neon-cyan/20"
          />
          <button type="submit" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-neon-cyan text-arcade-950 font-bold text-sm rounded-xl hover:bg-neon-yellow transition-colors">
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
            Tìm game
          </button>
        </form>

        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-4">
          <a
            href="/games"
            class="px-8 py-3.5 bg-gradient-to-r from-neon-cyan to-neon-yellow text-arcade-950 font-black rounded-lg hover:shadow-neon-cyan hover:scale-105 transition-all text-sm tracking-wider uppercase flex items-center gap-2"
          >
            <span>🎮</span>
            <span>Khám Phá Thư Viện</span>
          </a>

          <a
            href="/me/imports"
            class="px-6 py-3.5 bg-arcade-800 border-2 border-neon-pink/70 text-slate-100 font-bold rounded-lg hover:border-neon-pink hover:bg-neon-pink/10 transition-all text-sm flex items-center gap-2"
          >
            <span>💾</span>
            <span>Import File JAR Của Bạn</span>
          </a>
        </div>

        <!-- Highlights -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-arcade-800 max-w-md mx-auto lg:mx-0 text-left">
          <div>
            <div class="text-xl sm:text-2xl font-black text-neon-cyan font-mono">100%</div>
            <div class="text-[11px] text-slate-400">Chạy trên Web</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-neon-yellow font-mono">2D & 3D</div>
            <div class="text-[11px] text-slate-400">Canvas & WebGL</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-neon-green font-mono">FREE</div>
            <div class="text-[11px] text-slate-400">Lưu trữ riêng tư</div>
          </div>
        </div>
      </div>

      <div class="hidden lg:flex lg:col-span-5 justify-center">
        <HomeGamePreview
          client:media="(min-width: 1024px)"
          slug="ninja-school-3"
          previewSrc={ninjaPreview.src}
        />
      </div>
    </div>
  </div>
</section>
