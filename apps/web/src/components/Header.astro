---
import UserNav from './UserNav';
---

<header class="sticky top-0 z-40 bg-arcade-950/90 backdrop-blur-md border-b border-arcade-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group flex-shrink-0">
        <div class="w-10 h-10 rounded bg-arcade-800 border-2 border-neon-cyan flex items-center justify-center shadow-neon-cyan group-hover:scale-105 transition-transform">
          <span class="text-xl">🕹️</span>
        </div>
        <div>
          <span class="font-extrabold text-xl tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan via-neon-yellow to-neon-pink text-glow-cyan">
            GAME TUỔI THƠ
          </span>
          <span class="block text-[10px] text-neon-cyan/70 font-mono tracking-widest uppercase">
            J2ME Retro Platform
          </span>
        </div>
      </a>

      <!-- Navigation links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a href="/" class="text-slate-300 hover:text-neon-cyan transition-colors">
          Trang chủ
        </a>
        <a href="/games" class="text-slate-300 hover:text-neon-cyan transition-colors">
          Kho Game (Catalog)
        </a>
        <a href="/me/imports" class="text-slate-300 hover:text-neon-yellow transition-colors flex items-center gap-1.5">
          <span>Tải lên JAR</span>
          <span class="text-[10px] bg-neon-yellow/20 text-neon-yellow px-1.5 py-0.2 rounded font-mono">FREE</span>
        </a>
        <a href="/me/library" class="text-slate-300 hover:text-neon-cyan transition-colors">
          Thư viện của tôi
        </a>
      </nav>

      <!-- Search bar & User Account -->
      <div class="flex items-center gap-4">
        <form action="/games" method="GET" class="hidden sm:block relative">
          <input
            type="text"
            name="search"
            placeholder="Tìm game, thể loại..."
            class="w-48 lg:w-64 bg-arcade-800/80 border border-arcade-700 focus:border-neon-cyan rounded-full px-4 py-1.5 text-xs text-slate-100 placeholder-slate-400 focus:outline-none transition-all focus:w-72"
          />
          <button type="submit" class="absolute right-3 top-2 text-slate-400 hover:text-neon-cyan text-xs">
            🔍
          </button>
        </form>

        <UserNav client:load />
      </div>
    </div>
  </div>
</header>
