---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Đăng Nhập --- Game Tuổi Thơ">
  <div class="max-w-md mx-auto px-4 py-10 sm:py-16">
    <div class="bg-arcade-900 border border-arcade-800 rounded-3xl p-6 sm:p-8 shadow-2xl">
      <div class="text-center mb-6">
        <span class="text-4xl">🕹️</span>
        <h1 class="text-2xl font-black text-slate-100 mt-2">Đăng Nhập</h1>
        <p class="text-xs text-slate-400 mt-1">
          Lưu trữ game yêu thích, lịch sử chơi và import game của riêng bạn
        </p>
      </div>

      <div id="session-alert" role="status" class="hidden mb-4 p-3 bg-neon-yellow/10 border border-neon-yellow/50 text-neon-yellow text-xs rounded-lg font-medium"></div>
      <div id="error-alert" role="alert" class="hidden mb-4 p-3 bg-red-500/20 border border-red-500 text-red-200 text-xs rounded-lg font-medium"></div>

      <!-- Sign in with Google: shown only when the server has GOOGLE_CLIENT_ID configured -->
      <div id="google-block" class="hidden mb-6">
        <div data-google-button class="flex justify-center min-h-[44px] w-full"></div>
        <div class="flex items-center gap-3 mt-6 text-[11px] text-slate-500 uppercase tracking-widest">
          <span class="flex-1 h-px bg-arcade-700"></span>
          <span>hoặc dùng tài khoản</span>
          <span class="flex-1 h-px bg-arcade-700"></span>
        </div>
      </div>

      <form id="login-form" class="space-y-4">
        <div>
          <label for="usernameOrEmail" class="block text-xs font-semibold text-slate-300 mb-1">
            Tên đăng nhập hoặc Email
          </label>
          <input
            type="text"
            id="usernameOrEmail"
            required
            autocomplete="username"
            class="w-full bg-arcade-800 border border-arcade-700 focus:border-neon-cyan rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none"
            placeholder="Tên đăng nhập hoặc email@..."
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-slate-300 mb-1">
            Mật khẩu
          </label>
          <input
            type="password"
            id="password"
            required
            autocomplete="current-password"
            class="w-full bg-arcade-800 border border-arcade-700 focus:border-neon-cyan rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none"
            placeholder="••••••••"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full py-3 bg-neon-cyan hover:bg-neon-yellow text-arcade-950 font-black rounded-xl text-sm transition-all shadow-neon-cyan tracking-wider uppercase mt-2"
        >
          ĐĂNG NHẬP
        </button>
      </form>

      <div class="mt-6 text-center text-xs text-slate-400">
        Chưa có tài khoản?{' '}
        <a href="/register" class="text-neon-cyan hover:underline font-bold">
          Đăng ký ngay
        </a>
      </div>
    </div>
  </div>

  <script>
    import { loginUser, safeNextPath } from '../lib/api';
    import { mountGoogleSignIn } from '../lib/googleSignIn';
    import type { User } from '@gametuoitho/shared-types';

    // Explain why the user landed here (session expired / page needs login).
    const params = new URLSearchParams(window.location.search);
    const nextPath = safeNextPath(params.get('next'));
    const sessionAlert = document.getElementById('session-alert') as HTMLDivElement;
    const errorAlert = document.getElementById('error-alert') as HTMLDivElement;
    const reasonMessage =
      params.get('reason') === 'expired'
        ? '⚠️ Phiên đăng nhập đã hết hạn hoặc không còn hợp lệ. Vui lòng đăng nhập lại.'
        : params.get('reason') === 'login'
          ? '🔒 Vui lòng đăng nhập để tiếp tục.'
          : '';
    if (reasonMessage && sessionAlert) {
      sessionAlert.textContent = reasonMessage;
      sessionAlert.classList.remove('hidden');
    }

    const goAfterLogin = (user: User | undefined) => {
      const isAdmin = user?.role === 'ADMIN';
      const backTo = nextPath && (isAdmin || !nextPath.startsWith('/admin')) ? nextPath : null;
      window.location.href = backTo || (isAdmin ? '/admin' : '/');
    };
    const showError = (message: string) => {
      sessionAlert?.classList.add('hidden');
      errorAlert.textContent = message;
      errorAlert.classList.remove('hidden');
    };

    const googleBlock = document.getElementById('google-block');
    if (googleBlock) {
      mountGoogleSignIn({ block: googleBlock, text: 'signin_with', onSuccess: goAfterLogin, onError: showError });
    }

    const usernameInput = document.getElementById('usernameOrEmail') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const form = document.getElementById('login-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'ĐANG XỬ LÝ...';

      sessionAlert?.classList.add('hidden');
      try {
        const res = await loginUser({
          usernameOrEmail: usernameInput.value.trim(),
          password: passwordInput.value,
        });

        if (res.success) {
          goAfterLogin(res.data?.user);
        } else {
          showError(res.error?.message || 'Đăng nhập thất bại');
          submitBtn.disabled = false;
          submitBtn.textContent = 'ĐĂNG NHẬP';
        }
      } catch (err: any) {
        showError(err.message || 'Lỗi kết nối');
        submitBtn.disabled = false;
        submitBtn.textContent = 'ĐĂNG NHẬP';
      }
    });
  </script>
</Layout>
