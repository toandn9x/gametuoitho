---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Giám Sát Game User Import" activeNav="imports">
  <div class="space-y-6">
    <div class="border-b border-arcade-800 pb-4">
      <h2 class="text-2xl font-black text-slate-100 flex items-center gap-2">
        <span>📥</span>
        <span>Quản Lý Game Do Người Dùng Tải Lên</span>
      </h2>
      <p class="text-xs text-slate-400 mt-1">
        Theo dõi dung lượng và trạng thái file người dùng import để bảo đảm an toàn hệ thống (mặc định PRIVATE)
      </p>
    </div>

    <!-- Imports Table -->
    <div class="bg-arcade-900 border border-arcade-800 rounded-2xl overflow-hidden shadow-xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-arcade-850 text-slate-400 uppercase font-mono text-[10px] border-b border-arcade-800">
            <tr>
              <th class="px-6 py-4">Tên Game & File</th>
              <th class="px-6 py-4">Người Sở Hữu</th>
              <th class="px-6 py-4">Dung Lượng</th>
              <th class="px-6 py-4">SHA-256 Checksum</th>
              <th class="px-6 py-4">Thời Gian</th>
              <th class="px-6 py-4 text-right">Thao Tác</th>
            </tr>
          </thead>
          <tbody id="imports-table-body" class="divide-y divide-arcade-800 text-slate-300">
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-slate-500 font-mono">
                Đang tải dữ liệu...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    import { getAdminImports, apiRequest } from '../../lib/api';

    async function loadImports() {
      const tbody = document.getElementById('imports-table-body')!;
      const res = await getAdminImports(1, 100);

      if (!res.success || !res.data || res.data.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-slate-500 font-mono">
              Chưa có file game nào do người dùng tải lên.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = res.data
        .map((item: any) => {
          return `
            <tr class="hover:bg-arcade-850/50 transition-colors">
              <td class="px-6 py-4">
                <span class="font-bold text-slate-100 block">${item.custom_name}</span>
                <span class="text-[10px] text-slate-500 font-mono">${item.custom_original_filename}</span>
              </td>
              <td class="px-6 py-4">
                <span class="font-semibold text-neon-cyan block">${item.owner_username}</span>
                <span class="text-[10px] text-slate-400">${item.owner_email}</span>
              </td>
              <td class="px-6 py-4 font-mono text-neon-yellow">
                ${((item.custom_file_size || 0) / 1024).toFixed(0)} KB
              </td>
              <td class="px-6 py-4 font-mono text-[10px] text-slate-500 truncate max-w-[120px]" title="${item.custom_sha256}">
                ${item.custom_sha256 ? item.custom_sha256.substring(0, 16) + '...' : 'N/A'}
              </td>
              <td class="px-6 py-4 text-slate-400 font-mono text-[11px]">
                ${new Date(item.created_at).toLocaleDateString('vi-VN')}
              </td>
              <td class="px-6 py-4 text-right">
                <button
                  data-id="${item.id}"
                  data-name="${item.custom_name}"
                  class="del-import-btn px-2.5 py-1 bg-red-500/10 text-red-400 border border-red-500/30 hover:bg-red-500 hover:text-white rounded text-xs font-bold transition-all"
                >
                  Gỡ bỏ
                </button>
              </td>
            </tr>
          `;
        })
        .join('');

      document.querySelectorAll('.del-import-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id')!;
          const name = (e.currentTarget as HTMLElement).getAttribute('data-name')!;
          if (!confirm(`Xóa file import "${name}" này do vi phạm chính sách?`)) return;

          await apiRequest(`/admin/imports/${id}`, { method: 'DELETE' });
          loadImports();
        });
      });
    }

    loadImports();
  </script>
</AdminLayout>
