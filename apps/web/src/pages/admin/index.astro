---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Dashboard Quản Trị Hệ Thống" activeNav="dashboard">
  <div class="space-y-8" id="admin-dashboard">
    <!-- Top Summary Banner -->
    <div class="bg-gradient-to-r from-neon-pink/15 via-arcade-850 to-neon-cyan/15 border border-arcade-800 rounded-3xl p-6 lg:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h2 class="text-2xl font-black text-slate-100 flex items-center gap-2">
          <span>🎮</span>
          <span>Tổng Quan Nền Tảng Game Tuổi Thơ</span>
        </h2>
        <p class="text-xs text-slate-400 mt-1">
          Theo dõi trạng thái Game Catalog, người dùng, lượt import và dung lượng R2
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/admin/crawler"
          class="px-4 py-2.5 bg-neon-cyan hover:bg-neon-yellow text-arcade-950 font-black rounded-xl text-xs transition-all flex items-center gap-2 shadow-neon-cyan"
        >
          <span>🕷️</span>
          <span>Nhập Game (gametuoitho.cc)</span>
        </a>

        <a
          href="/admin/games/create"
          class="px-4 py-2.5 bg-neon-pink hover:bg-neon-yellow text-arcade-950 font-bold rounded-xl text-xs transition-all flex items-center gap-1.5 shadow-neon-pink"
        >
          <span>➕</span>
          <span>Tạo Game Thủ Công</span>
        </a>
      </div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Card: Total Games & Status Breakdown -->
      <div class="bg-arcade-900 border border-arcade-800 hover:border-neon-cyan/60 rounded-2xl p-6 transition-all shadow-md group flex flex-col justify-between">
        <div>
          <a href="/admin/games" class="flex items-center justify-between text-xs text-slate-400 font-mono mb-2 group-hover:text-neon-cyan transition-colors">
            <span class="flex items-center gap-1.5 font-bold">
              <span>🕹️</span>
              <span>TỔNG SỐ GAME</span>
            </span>
            <span class="text-[10px] text-slate-500 group-hover:text-neon-cyan flex items-center">Xem tất cả →</span>
          </a>
          <a href="/admin/games" id="stat-total-games" class="text-3xl font-black text-neon-cyan font-mono block hover:scale-105 transition-transform origin-left">
            --
          </a>
        </div>
        <div class="mt-4 pt-3 border-t border-arcade-800/80 flex flex-wrap items-center gap-2 text-[11px] font-mono">
          <a
            id="stat-published"
            href="/admin/games?status=PUBLISHED"
            class="px-2 py-0.5 rounded-lg bg-neon-green/10 text-neon-green hover:bg-neon-green hover:text-arcade-950 border border-neon-green/30 font-bold transition-all flex items-center gap-1"
            title="Nhấn để xem danh sách game đã xuất bản"
          >
            <span>●</span>
            <span id="stat-published-text">-- Đã xuất bản</span>
          </a>
          <a
            id="stat-draft"
            href="/admin/games?status=DRAFT"
            class="px-2 py-0.5 rounded-lg bg-neon-yellow/10 text-neon-yellow hover:bg-neon-yellow hover:text-arcade-950 border border-neon-yellow/30 font-bold transition-all flex items-center gap-1"
            title="Nhấn để xem danh sách game bản nháp"
          >
            <span>●</span>
            <span id="stat-draft-text">-- Bản nháp</span>
          </a>
        </div>
      </div>

      <!-- Card: User Accounts -->
      <a
        href="/admin/user-imports"
        class="bg-arcade-900 border border-arcade-800 hover:border-neon-yellow/60 rounded-2xl p-6 transition-all shadow-md group flex flex-col justify-between block"
      >
        <div>
          <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-2 group-hover:text-neon-yellow transition-colors">
            <span class="flex items-center gap-1.5 font-bold">
              <span>👥</span>
              <span>NGƯỜI DÙNG</span>
            </span>
            <span class="text-[10px] text-slate-500 group-hover:text-neon-yellow">Chi tiết →</span>
          </div>
          <div id="stat-total-users" class="text-3xl font-black text-neon-yellow font-mono group-hover:scale-105 transition-transform origin-left">--</div>
        </div>
        <div class="text-[11px] text-slate-500 mt-4 pt-3 border-t border-arcade-800/80">
          Tài khoản thành viên trên hệ thống
        </div>
      </a>

      <!-- Card: User Imports -->
      <a
        href="/admin/user-imports"
        class="bg-arcade-900 border border-arcade-800 hover:border-neon-pink/60 rounded-2xl p-6 transition-all shadow-md group flex flex-col justify-between block"
      >
        <div>
          <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-2 group-hover:text-neon-pink transition-colors">
            <span class="flex items-center gap-1.5 font-bold">
              <span>📥</span>
              <span>USER IMPORTS</span>
            </span>
            <span class="text-[10px] text-slate-500 group-hover:text-neon-pink">Quản lý →</span>
          </div>
          <div id="stat-total-imports" class="text-3xl font-black text-neon-pink font-mono group-hover:scale-105 transition-transform origin-left">--</div>
        </div>
        <div class="text-[11px] text-slate-500 mt-4 pt-3 border-t border-arcade-800/80">
          File JAR cá nhân do người dùng tải lên
        </div>
      </a>

      <!-- Card: R2 Storage -->
      <a
        href="/admin/storage"
        class="bg-arcade-900 border border-arcade-800 hover:border-neon-green/60 rounded-2xl p-6 transition-all shadow-md group flex flex-col justify-between block"
      >
        <div>
          <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-2 group-hover:text-neon-green transition-colors">
            <span class="flex items-center gap-1.5 font-bold">
              <span>💾</span>
              <span>DUNG LƯỢNG R2</span>
            </span>
            <span class="text-[10px] text-slate-500 group-hover:text-neon-green">Quản lý kho →</span>
          </div>
          <div id="stat-total-storage" class="text-3xl font-black text-neon-green font-mono group-hover:scale-105 transition-transform origin-left">--</div>
        </div>
        <div class="text-[11px] text-slate-500 mt-4 pt-3 border-t border-arcade-800/80">
          Tổng tài nguyên nhị phân trên kho lưu trữ
        </div>
      </a>
    </div>

    <!-- Crawler Promo Banner -->
    <div class="bg-gradient-to-r from-neon-cyan/20 via-arcade-900 to-neon-pink/20 border-2 border-neon-cyan/50 rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 shadow-neon-cyan">
      <div class="space-y-2 max-w-xl">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 bg-neon-cyan text-arcade-950 text-[10px] font-mono font-black rounded-full uppercase">
            CÔNG CỤ ĐỘC QUYỀN
          </span>
          <span class="text-xs text-neon-yellow font-mono font-bold">
            ⚡ 3.350+ Game Sẵn Sàng
          </span>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-slate-100 flex items-center gap-2">
          <span>🕷️</span>
          <span>Cào & Tự Động Nhập Game Từ gametuoitho.cc</span>
        </h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          Tìm kiếm và nạp tự động file JAR + ảnh bìa vào kho game chỉ với <strong>1 cú click chuột</strong>. Không cần tìm hay upload file thủ công!
        </p>
      </div>
      <a
        href="/admin/crawler"
        class="px-6 py-3.5 bg-gradient-to-r from-neon-cyan to-neon-yellow text-arcade-950 font-black rounded-xl text-xs hover:scale-105 transition-all shadow-lg flex items-center gap-2 flex-shrink-0"
      >
        <span>Mở Bộ Cào Game Ngay</span>
        <span>→</span>
      </a>
    </div>

    <!-- Quick Actions & Guidelines -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="bg-arcade-900 border border-arcade-800 rounded-2xl p-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-neon-cyan mb-4 flex items-center gap-2">
          <span>⚡</span>
          <span>Hành Động Quản Trị Nhanh</span>
        </h3>
        <div class="grid grid-cols-2 gap-3">
          <a
            href="/admin/crawler"
            class="p-4 bg-neon-cyan/10 hover:bg-neon-cyan/20 border border-neon-cyan/40 rounded-xl transition-all block group col-span-2"
          >
            <div class="flex items-center justify-between">
              <span class="text-2xl block mb-1">🕷️</span>
              <span class="px-2 py-0.5 bg-neon-cyan text-arcade-950 text-[10px] font-bold rounded">HOT</span>
            </div>
            <span class="font-bold text-xs text-neon-cyan group-hover:text-neon-yellow block">
              Nhập Game Tự Động (gametuoitho.cc)
            </span>
            <span class="text-[10px] text-slate-400 block mt-1">Duyệt & tải hơn 3.350 game Nokia J2ME với 1-click</span>
          </a>

          <a
            href="/admin/games"
            class="p-4 bg-arcade-800/80 hover:bg-arcade-700/80 border border-arcade-700 rounded-xl transition-all block group"
          >
            <span class="text-xl block mb-1">🎮</span>
            <span class="font-bold text-xs text-slate-200 group-hover:text-neon-cyan block">
              Duyệt & Quản Lý Game
            </span>
            <span class="text-[10px] text-slate-400 block mt-1">Xuất bản, ẩn hoặc xóa game</span>
          </a>

          <a
            href="/admin/games/create"
            class="p-4 bg-arcade-800/80 hover:bg-arcade-700/80 border border-arcade-700 rounded-xl transition-all block group"
          >
            <span class="text-xl block mb-1">📤</span>
            <span class="font-bold text-xs text-slate-200 group-hover:text-neon-pink block">
              Upload Game Mới
            </span>
            <span class="text-[10px] text-slate-400 block mt-1">Nhập metadata và file JAR</span>
          </a>

          <a
            href="/admin/categories"
            class="p-4 bg-arcade-800/80 hover:bg-arcade-700/80 border border-arcade-700 rounded-xl transition-all block group"
          >
            <span class="text-xl block mb-1">🏷️</span>
            <span class="font-bold text-xs text-slate-200 group-hover:text-neon-yellow block">
              Thể Loại Game
            </span>
            <span class="text-[10px] text-slate-400 block mt-1">Thêm hoặc sắp xếp thể loại</span>
          </a>

          <a
            href="/admin/user-imports"
            class="p-4 bg-arcade-800/80 hover:bg-arcade-700/80 border border-arcade-700 rounded-xl transition-all block group"
          >
            <span class="text-xl block mb-1">🛡️</span>
            <span class="font-bold text-xs text-slate-200 group-hover:text-neon-green block">
              Kiểm Soát Imports
            </span>
            <span class="text-[10px] text-slate-400 block mt-1">Giám sát dung lượng và file</span>
          </a>

          <a
            href="/admin/reports"
            class="p-4 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 rounded-xl transition-all block group"
          >
            <span class="text-xl block mb-1">🚨</span>
            <span class="font-bold text-xs text-red-400 group-hover:text-red-300 block">
              Báo Cáo & Log Lỗi
            </span>
            <span class="text-[10px] text-slate-400 block mt-1">Theo dõi lỗi crash & hỏng game</span>
          </a>

          <a
            href="/admin/storage"
            class="p-4 bg-neon-green/10 hover:bg-neon-green/20 border border-neon-green/30 rounded-xl transition-all block group"
          >
            <span class="text-xl block mb-1">🧹</span>
            <span class="font-bold text-xs text-neon-green group-hover:text-neon-yellow block">
              Dọn Dẹp Dung Lượng
            </span>
            <span class="text-[10px] text-slate-400 block mt-1">Quét & dọn file mồ côi (orphans)</span>
          </a>
        </div>
      </div>

      <div class="bg-arcade-900 border border-arcade-800 rounded-2xl p-6">
        <h3 class="text-sm font-bold uppercase tracking-wider text-neon-pink mb-4 flex items-center gap-2">
          <span>📋</span>
          <span>Nguyên Tắc Xuất Bản & Bảo Mật (PLAN.md)</span>
        </h3>
        <ul class="space-y-3 text-xs text-slate-300">
          <li class="flex items-start gap-2">
            <span class="text-neon-green font-bold">✓</span>
            <span>Không tự động xuất bản game ngay khi upload: Game luôn lưu ở trạng thái DRAFT để kiểm thử trước khi Publish.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-neon-green font-bold">✓</span>
            <span>Quyền riêng tư: File do người dùng import luôn mặc định ở chế độ PRIVATE, không hiển thị ra Catalog công khai.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-neon-green font-bold">✓</span>
            <span>An toàn máy chủ: Tuyệt đối không thực thi file JAR trên máy chủ backend; file chỉ chạy an toàn trong sandbox trình duyệt.</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <script>
    import { getAdminStats } from '../../lib/api';

    getAdminStats().then((res) => {
      if (res.success && res.data) {
        const d = res.data;
        const totalEl = document.getElementById('stat-total-games');
        const pubText = document.getElementById('stat-published-text');
        const draftText = document.getElementById('stat-draft-text');
        const usersEl = document.getElementById('stat-total-users');
        const importsEl = document.getElementById('stat-total-imports');
        const storageEl = document.getElementById('stat-total-storage');

        if (totalEl) totalEl.textContent = String(d.totalGames);
        if (pubText) pubText.textContent = `${d.publishedGames} Đã xuất bản`;
        if (draftText) draftText.textContent = `${d.draftGames} Bản nháp`;
        if (usersEl) usersEl.textContent = String(d.totalUsers);
        if (importsEl) importsEl.textContent = String(d.totalImports);
        if (storageEl) storageEl.textContent = d.storageFormatted;
      }
    });
  </script>
</AdminLayout>
