---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Đăng Ký Tài Khoản --- Game Tuổi Thơ">
  <div class="max-w-md mx-auto px-4 py-16">
    <div class="bg-arcade-900 border border-arcade-800 rounded-3xl p-8 shadow-2xl">
      <div class="text-center mb-6">
        <span class="text-4xl">✨</span>
        <h1 class="text-2xl font-black text-slate-100 mt-2">Tạo Tài Khoản Mới</h1>
        <p class="text-xs text-slate-400 mt-1">
          Gia nhập cộng đồng game thủ hoài niệm J2ME
        </p>
      </div>

      <!-- Sign up with Google: shown only when the server has GOOGLE_CLIENT_ID configured -->
      <div id="google-block" class="hidden mb-6">
        <div data-google-button class="flex justify-center min-h-[44px] w-full"></div>
        <div class="flex items-center gap-3 mt-6 text-[11px] text-slate-500 uppercase tracking-widest">
          <span class="flex-1 h-px bg-arcade-700"></span>
          <span>hoặc tạo tài khoản</span>
          <span class="flex-1 h-px bg-arcade-700"></span>
        </div>
      </div>

      <form id="register-form" class="space-y-4">
        <div id="error-alert" role="alert" class="hidden p-3 bg-red-500/20 border border-red-500 text-red-200 text-xs rounded-lg font-medium"></div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">
            Tên người dùng (Username)
          </label>
          <input
            type="text"
            id="username"
            required
            minlength="3"
            maxlength="30"
            class="w-full bg-arcade-800 border border-arcade-700 focus:border-neon-cyan rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none font-mono"
            placeholder="vd: ninja9x"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">
            Địa chỉ Email
          </label>
          <input
            type="email"
            id="email"
            required
            class="w-full bg-arcade-800 border border-arcade-700 focus:border-neon-cyan rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none"
            placeholder="name@example.com"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">
            Mật khẩu (Tối thiểu 6 ký tự)
          </label>
          <input
            type="password"
            id="password"
            required
            minlength="6"
            class="w-full bg-arcade-800 border border-arcade-700 focus:border-neon-cyan rounded-xl px-4 py-2.5 text-sm text-slate-100 placeholder-slate-500 focus:outline-none"
            placeholder="••••••••"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full py-3 bg-neon-cyan hover:bg-neon-yellow text-arcade-950 font-black rounded-xl text-sm transition-all shadow-neon-cyan tracking-wider uppercase mt-2"
        >
          TẠO TÀI KHOẢN
        </button>
      </form>

      <div class="mt-6 text-center text-xs text-slate-400">
        Đã có tài khoản?{' '}
        <a href="/login" class="text-neon-cyan hover:underline font-bold">
          Đăng nhập ngay
        </a>
      </div>
    </div>
  </div>

  <script>
    import { registerUser } from '../lib/api';
    import { mountGoogleSignIn } from '../lib/googleSignIn';

    const usernameInput = document.getElementById('username') as HTMLInputElement;
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const passwordInput = document.getElementById('password') as HTMLInputElement;
    const form = document.getElementById('register-form') as HTMLFormElement;
    const errorAlert = document.getElementById('error-alert') as HTMLDivElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    const googleBlock = document.getElementById('google-block');
    if (googleBlock) {
      mountGoogleSignIn({
        block: googleBlock,
        text: 'signup_with',
        onSuccess: (user) => {
          window.location.href = user.role === 'ADMIN' ? '/admin' : '/';
        },
        onError: (message) => {
          errorAlert.textContent = message;
          errorAlert.classList.remove('hidden');
        },
      });
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'ĐANG TẠO...';

      try {
        const res = await registerUser({
          username: usernameInput.value.trim(),
          email: emailInput.value.trim(),
          password: passwordInput.value,
        });

        if (res.success) {
          window.location.href = '/';
        } else {
          errorAlert.textContent = res.error?.message || 'Đăng ký thất bại';
          errorAlert.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'TẠO TÀI KHOẢN';
        }
      } catch (err: any) {
        errorAlert.textContent = err.message || 'Lỗi kết nối';
        errorAlert.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'TẠO TÀI KHOẢN';
      }
    });
  </script>
</Layout>
