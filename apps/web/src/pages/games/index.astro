---
import Layout from '../../layouts/Layout.astro';
import GameCatalogView from '../../components/GameCatalogView';
---

<Layout title="Kho Game Java ME (J2ME) Tuổi Thơ --- Danh Sách Đầy Đủ">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="border-b border-arcade-800 pb-8 mb-4">
      <h1 class="text-3xl font-black text-slate-100 flex items-center gap-3">
        <span class="text-neon-cyan">🕹️</span>
        <span>Kho Game Tuổi Thơ</span>
      </h1>
      <p class="text-slate-400 text-sm mt-2">
        Duyệt và tìm kiếm hàng trăm tựa game Java Nokia huyền thoại sẵn sàng chơi ngay
      </p>
    </div>

    <!-- Client-driven Interactive Catalog -->
    <GameCatalogView client:load />
  </div>
</Layout>
