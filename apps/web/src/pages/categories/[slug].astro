---
import Layout from '../../layouts/Layout.astro';
import CategoryGamesView from '../../components/CategoryGamesView';
import { getCategories } from '../../lib/api';

export async function getStaticPaths() {
  const catRes = await getCategories();
  const categories = catRes.success && catRes.data && catRes.data.length > 0 ? catRes.data : [
    { slug: 'nhap-vai', name: 'Nhập vai (RPG)' },
    { slug: 'hanh-dong', name: 'Hành động' },
    { slug: 'tri-tue', name: 'Trí tuệ & Giải đố' },
    { slug: 'the-thao-dua-xe', name: 'Đua xe & Thể thao' },
    { slug: 'doi-song', name: 'Đời sống & Nông trại' },
    { slug: 'ban-sung', name: 'Bắn súng & Arcade' },
  ];
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { name: cat.name },
  }));
}

const { slug } = Astro.params;
const { name } = Astro.props;
const categoryName = name || slug;
---

<Layout title={`Thể loại: ${categoryName} --- Game Tuổi Thơ`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="border-b border-arcade-800 pb-6 mb-8">
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-2 font-mono">
        <a href="/" class="hover:text-neon-cyan">Trang chủ</a>
        <span>/</span>
        <a href="/games" class="hover:text-neon-cyan">Thể loại</a>
        <span>/</span>
        <span class="text-neon-cyan font-bold">{categoryName}</span>
      </div>

      <h1 class="text-3xl font-black text-slate-100 flex items-center gap-3">
        <span class="text-neon-yellow">📁</span>
        <span>Thể Loại: {categoryName}</span>
      </h1>
    </div>

    <!-- Category Games View -->
    <CategoryGamesView client:load categorySlug={slug || ''} />
  </div>
</Layout>
