---
import Layout from '../../layouts/Layout.astro';
import CategoryGamesView from '../../components/CategoryGamesView';
import { getCategories } from '../../lib/api';

export async function getStaticPaths() {
  const catRes = await getCategories();
  const categories = catRes.success && Array.isArray(catRes.data) ? catRes.data : [];
  const paths = [{ params: { slug: '_shell' }, props: { name: 'Danh mục' } }];
  for (const cat of categories) {
    if (cat.slug && cat.slug !== '_shell') {
      paths.push({
        params: { slug: cat.slug },
        props: { name: cat.name },
      });
    }
  }
  return paths;
}

const { slug } = Astro.params;
const { name } = Astro.props;
const isShell = !slug || slug === '_shell';
const categoryName = name || (isShell ? 'Danh mục' : slug);
---

<Layout title={`Thể loại: ${categoryName} --- Game Tuổi Thơ`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="border-b border-arcade-800 pb-6 mb-8">
      <div class="flex items-center gap-2 text-xs text-slate-400 mb-2 font-mono">
        <a href="/" class="hover:text-neon-cyan">Trang chủ</a>
        <span>/</span>
        <a href="/games" class="hover:text-neon-cyan">Thể loại</a>
        <span>/</span>
        <span id="category-crumb" class="text-neon-cyan font-bold">{categoryName}</span>
      </div>

      <h1 class="text-3xl font-black text-slate-100 flex items-center gap-3">
        <span class="text-neon-yellow">📁</span>
        <span id="category-title">Thể Loại: {categoryName}</span>
      </h1>
    </div>

    <!-- Category Games View -->
    <CategoryGamesView client:load categorySlug={slug || ''} />
  </div>
</Layout>

<script>
  import { getCategories } from '../../lib/api';

  // Pages built without category data (shell build, e.g. Cloudflare, or categories added after
  // the build) get the real category name from the API.
  const slug = decodeURIComponent(window.location.pathname.replace(/^\/categories\/?/, '').replace(/\/$/, ''));
  if (slug && slug !== '_shell') {
    getCategories().then((res) => {
      const category = res.success && Array.isArray(res.data) ? res.data.find((c) => c.slug === slug) : undefined;
      if (!category) return;
      const crumb = document.getElementById('category-crumb');
      const title = document.getElementById('category-title');
      if (crumb) crumb.textContent = category.name;
      if (title) title.textContent = `Thể Loại: ${category.name}`;
      document.title = `Thể loại: ${category.name} --- Game Tuổi Thơ`;
    });
  }
</script>
