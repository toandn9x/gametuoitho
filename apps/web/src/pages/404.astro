---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Không Tìm Thấy Trang --- Game Tuổi Thơ">
  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-arcade-800 border-2 border-neon-cyan/40 mb-6 text-4xl shadow-neon-cyan">
      👾
    </div>
    <h1 class="text-4xl sm:text-5xl font-black text-slate-100 mb-4 tracking-tight">
      404 - Không Tìm Thấy Trang
    </h1>
    <p class="text-slate-400 text-sm sm:text-base mb-8 max-w-lg mx-auto">
      Trang bạn đang tìm kiếm không tồn tại hoặc đã được di chuyển. Hãy quay về trang chủ để khám phá kho game tuổi thơ.
    </p>
    <div class="flex items-center justify-center gap-4">
      <a
        href="/"
        class="px-6 py-3 bg-neon-cyan text-arcade-950 font-bold rounded-xl hover:bg-neon-yellow transition-all text-sm shadow-md"
      >
        Về Trang Chủ
      </a>
      <a
        href="/games"
        class="px-6 py-3 bg-arcade-800 hover:bg-arcade-700 text-slate-200 border border-arcade-700 font-bold rounded-xl transition-all text-sm"
      >
        Khám Phá Game
      </a>
    </div>
  </div>
</Layout>
