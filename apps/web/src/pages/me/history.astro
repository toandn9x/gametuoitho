---
import Layout from '../../layouts/Layout.astro';
import RecentGames from '../../components/RecentGames';
---

<Layout title="Chơi gần đây --- Game Tuổi Thơ">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="border-b border-arcade-800 pb-6 mb-8">
      <h1 class="text-2xl sm:text-3xl font-black text-slate-100 flex items-center gap-3">
        <span class="text-neon-cyan">🕒</span>
        <span>Chơi gần đây</span>
      </h1>
      <p class="text-slate-400 text-sm mt-1">
        Tiếp tục những game bạn vừa chơi, mới nhất ở đầu danh sách.
      </p>
    </div>

    <RecentGames client:load fullPage />
  </div>
</Layout>
