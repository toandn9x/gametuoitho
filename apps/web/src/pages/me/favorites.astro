---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Game Yêu Thích --- Game Tuổi Thơ">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="border-b border-arcade-800 pb-6 mb-8">
      <h1 class="text-3xl font-black text-slate-100 flex items-center gap-3">
        <span class="text-neon-pink">⭐</span>
        <span>Game Yêu Thích Của Bạn</span>
      </h1>
      <p class="text-slate-400 text-sm mt-1">
        Những trò chơi bạn đánh dấu yêu thích để truy cập nhanh
      </p>
    </div>

    <div id="favorites-container">
      <div class="text-center py-20 bg-arcade-900 rounded-3xl border border-arcade-800">
        <span class="text-5xl">⭐</span>
        <h3 class="text-lg font-bold text-slate-200 mt-4">Chưa có game yêu thích nào</h3>
        <p class="text-xs text-slate-400 mt-1">
          Bấm biểu tượng ngôi sao trên trang game để lưu vào danh sách yêu thích
        </p>
        <a href="/games" class="inline-block mt-4 text-xs font-bold text-neon-cyan hover:underline">
          Khám phá Kho Game
        </a>
      </div>
    </div>
  </div>
</Layout>
