---
import Layout from '../../layouts/Layout.astro';
import PlayGameClient from '../../components/PlayGameClient';
import { getGameDetail, getGames } from '../../lib/api';

export async function getStaticPaths() {
  const gamesRes = await getGames({ limit: 100 });
  const games = gamesRes.success && gamesRes.data && gamesRes.data.length > 0 ? gamesRes.data : [
    { slug: 'ninja-school' },
    { slug: 'diamond-rush' },
    { slug: 'bounce-tales' },
    { slug: 'avatar' },
    { slug: 'asphalt-3' },
    { slug: 'space-impact' },
  ];
  return games.map((game) => ({
    params: { slug: game.slug },
  }));
}

const { slug } = Astro.params;
const detailRes = await getGameDetail(slug || '');
const gameName = detailRes.success && detailRes.data?.game?.name ? detailRes.data.game.name : slug;
---

<Layout
  title={`Đang Chơi: ${gameName} --- Game Tuổi Thơ Web Player`}
  description={`Chơi ${gameName} J2ME trực tiếp trên trình duyệt web.`}
>
  <PlayGameClient
    client:load
    slug={slug || ''}
    initialGame={detailRes.success && detailRes.data?.game ? detailRes.data.game : undefined}
    initialVersions={detailRes.success && detailRes.data?.versions ? detailRes.data.versions : undefined}
  />
</Layout>
