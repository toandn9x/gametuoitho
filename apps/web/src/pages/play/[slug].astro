---
import Layout from '../../layouts/Layout.astro';
import PlayGameClient from '../../components/PlayGameClient';
import { getGameDetail, getGames } from '../../lib/api';

export async function getStaticPaths() {
  const gamesRes = await getGames({ limit: 100 });
  const games = gamesRes.success && Array.isArray(gamesRes.data) ? gamesRes.data : [];
  const paths = [{ params: { slug: '_shell' } }];
  for (const game of games) {
    if (game.slug && game.slug !== '_shell') {
      paths.push({ params: { slug: game.slug } });
    }
  }
  return paths;
}

const { slug } = Astro.params;
const isShell = !slug || slug === '_shell';
const detailRes = isShell ? { success: false, data: null } : await getGameDetail(slug);
const gameName = detailRes.success && detailRes.data?.game?.name ? detailRes.data.game.name : (isShell ? 'Trò chơi' : slug);
---

<Layout
  title={`Đang Chơi: ${gameName} --- Game Tuổi Thơ Web Player`}
  description={`Chơi ${gameName} J2ME trực tiếp trên trình duyệt web.`}
>
  <PlayGameClient
    client:load
    slug={slug || ''}
    initialGame={detailRes.success && detailRes.data?.game ? detailRes.data.game : undefined}
    initialVersions={detailRes.success && detailRes.data?.versions ? detailRes.data.versions : undefined}
  />
</Layout>
