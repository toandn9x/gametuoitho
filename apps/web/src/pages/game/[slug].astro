---
import Layout from '../../layouts/Layout.astro';
import GameDetailClient from '../../components/GameDetailClient';
import { getGameDetail, getGames } from '../../lib/api';

export async function getStaticPaths() {
  const gamesRes = await getGames({ limit: 100 });
  const games = gamesRes.success && gamesRes.data && gamesRes.data.length > 0 ? gamesRes.data : [
    { slug: 'ninja-school' },
    { slug: 'diamond-rush' },
    { slug: 'bounce-tales' },
    { slug: 'avatar' },
    { slug: 'asphalt-3' },
    { slug: 'space-impact' },
  ];
  return games.map((game) => ({
    params: { slug: game.slug },
  }));
}

const { slug } = Astro.params;
const detailRes = await getGameDetail(slug || '');
const gameName = detailRes.success && detailRes.data?.game?.name ? detailRes.data.game.name : slug;
---

<Layout
  title={`${gameName} --- Chơi Game Java ME Online | Game Tuổi Thơ`}
  description={`Chơi ngay ${gameName} trên trình duyệt web.`}
>
  <GameDetailClient
    client:load
    slug={slug || ''}
    initialData={detailRes.success && detailRes.data ? detailRes.data : undefined}
  />
</Layout>
