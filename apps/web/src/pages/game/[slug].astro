---
import Layout from '../../layouts/Layout.astro';
import { getGameDetail, getGames } from '../../lib/api';

export async function getStaticPaths() {
  const gamesRes = await getGames({ limit: 100 });
  const games = gamesRes.success && gamesRes.data && gamesRes.data.length > 0 ? gamesRes.data : [
    { slug: 'ninja-school' },
    { slug: 'diamond-rush' },
    { slug: 'bounce-tales' },
    { slug: 'avatar' },
    { slug: 'asphalt-3' },
    { slug: 'space-impact' },
  ];
  return games.map((game) => ({
    params: { slug: game.slug },
  }));
}

const { slug } = Astro.params;
const detailRes = await getGameDetail(slug || '');

if (!detailRes.success || !detailRes.data) {
  return Astro.redirect('/404');
}

const { game, versions, screenshots } = detailRes.data;
const activeVersion = versions[0];

// Fetch related games in same category
const relatedRes = await getGames({ categoryId: game.category_id, limit: 4 });
const relatedGames = relatedRes.success && relatedRes.data 
  ? relatedRes.data.filter((g) => g.id !== game.id).slice(0, 3) 
  : [];
---

<Layout
  title={`${game.name} --- Chơi Game Java ME Online | Game Tuổi Thơ`}
  description={game.description || `Chơi ngay ${game.name} trên trình duyệt web.`}
  image={game.cover_url || '/favicon.svg'}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs text-slate-400 mb-6 font-mono">
      <a href="/" class="hover:text-neon-cyan">Trang chủ</a>
      <span>/</span>
      <a href="/games" class="hover:text-neon-cyan">Kho game</a>
      <span>/</span>
      {game.category_slug && (
        <>
          <a href={`/categories/${game.category_slug}`} class="hover:text-neon-cyan">
            {game.category_name}
          </a>
          <span>/</span>
        </>
      )}
      <span class="text-neon-cyan font-bold">{game.name}</span>
    </div>

    <!-- Main Detail Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Left Column: Cover & Action CTAs -->
      <div class="lg:col-span-4 space-y-6">
        <div class="bg-arcade-900 border border-arcade-800 rounded-3xl p-6 shadow-xl">
          <!-- Cover -->
          <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-arcade-950 border border-arcade-700/50 shadow-inner mb-6 relative">
            {game.cover_url ? (
              <img
                src={game.cover_url}
                alt={game.name}
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full flex flex-col items-center justify-center text-slate-500">
                <span class="text-6xl mb-2">🕹️</span>
                <span class="text-xs font-mono text-neon-cyan/70">J2ME Retro</span>
              </div>
            )}
            {game.category_name && (
              <span class="absolute top-3 left-3 bg-arcade-950/90 text-neon-yellow border border-neon-yellow/40 text-xs font-bold px-2.5 py-1 rounded-md backdrop-blur-md">
                {game.category_name}
              </span>
            )}
          </div>

          <!-- Play Button CTA -->
          <a
            href={`/play/${game.slug}`}
            class="block w-full py-4 text-center bg-gradient-to-r from-neon-cyan via-neon-yellow to-neon-pink text-arcade-950 font-black text-base rounded-xl hover:scale-[1.02] transition-transform shadow-neon-cyan tracking-wider uppercase"
          >
            ▶ CHƠI TRÊN WEB NGAY
          </a>

          <!-- Download JAR -->
          {activeVersion?.jar_url && (
            <a
              href={activeVersion.jar_url}
              download={`${game.slug}.jar`}
              class="block w-full text-center py-2.5 mt-3 bg-arcade-800 hover:bg-arcade-700 border border-arcade-700 hover:border-slate-400 rounded-xl text-xs font-semibold text-slate-300 transition-colors"
            >
              📥 Tải File JAR ({((activeVersion.file_size || 0) / 1024).toFixed(0)} KB)
            </a>
          )}

          <!-- Metadata table -->
          <div class="mt-6 pt-6 border-t border-arcade-800 space-y-3 text-xs">
            <div class="flex justify-between py-1 border-b border-arcade-800/50">
              <span class="text-slate-400">Nhà phát triển:</span>
              <span class="font-bold text-slate-200">{game.developer || 'Đang cập nhật'}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-arcade-800/50">
              <span class="text-slate-400">Nhà phát hành:</span>
              <span class="font-bold text-slate-200">{game.publisher || 'Đang cập nhật'}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-arcade-800/50">
              <span class="text-slate-400">Năm phát hành:</span>
              <span class="font-mono font-bold text-neon-cyan">{game.release_year || 'N/A'}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-arcade-800/50">
              <span class="text-slate-400">Nền tảng hỗ trợ:</span>
              <span class="font-mono text-neon-green">Web (CheerpJ) / Android APK</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-slate-400">Phân giải khuyến nghị:</span>
              <span class="font-mono text-slate-200">240x320 / Tự co giãn</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Info, Versions, Instructions -->
      <div class="lg:col-span-8 space-y-8">
        <!-- Title & Badges -->
        <div>
          <h1 class="text-3xl sm:text-4xl font-black text-slate-100">{game.name}</h1>
          <div class="flex flex-wrap items-center gap-3 mt-3">
            <span class="px-3 py-1 bg-neon-green/20 text-neon-green border border-neon-green/40 text-xs font-mono font-bold rounded-full">
              ✓ Đã Kiểm Thử Tương Thích
            </span>
            <span class="px-3 py-1 bg-arcade-800 text-slate-300 border border-arcade-700 text-xs rounded-full font-mono">
              MIDP 2.0 / CLDC 1.1
            </span>
          </div>
        </div>

        <!-- Description -->
        <div class="bg-arcade-900 border border-arcade-800 rounded-2xl p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-neon-cyan mb-3">
            Giới Thiệu Game
          </h2>
          <p class="text-slate-300 text-sm leading-relaxed whitespace-pre-line">
            {game.description || 'Chưa có mô tả chi tiết cho tựa game này.'}
          </p>
        </div>

        <!-- Versions List -->
        <div class="bg-arcade-900 border border-arcade-800 rounded-2xl p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-neon-yellow mb-3">
            Phiên Bản File JAR
          </h2>
          {versions.length > 0 ? (
            <div class="space-y-2">
              {versions.map((ver) => (
                <div class="flex items-center justify-between p-3 bg-arcade-800/60 border border-arcade-700 rounded-xl text-xs">
                  <div>
                    <span class="font-bold text-slate-200">{ver.version_name}</span>
                    <span class="block text-[10px] text-slate-500 font-mono mt-0.5">
                      Dung lượng: {((ver.file_size || 0) / 1024).toFixed(0)} KB
                    </span>
                  </div>
                  <a
                    href={`/play/${game.slug}`}
                    class="px-3 py-1.5 bg-neon-cyan text-arcade-950 font-bold rounded hover:bg-neon-yellow transition-all"
                  >
                    Chơi bản này
                  </a>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-xs text-slate-400">Chưa có phiên bản nào.</p>
          )}
        </div>

        <!-- Controls Guide -->
        <div class="bg-arcade-900 border border-arcade-800 rounded-2xl p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-neon-pink mb-3">
            Hướng Dẫn Phím Điều Khiển Trên Máy Tính & Điện Thoại
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-mono">
            <div class="p-3 bg-arcade-800 rounded-lg border border-arcade-700 text-center">
              <span class="text-neon-cyan font-bold block mb-1">Mũi tên / 2 4 6 8</span>
              <span class="text-[11px] text-slate-400">Di chuyển nhân vật</span>
            </div>
            <div class="p-3 bg-arcade-800 rounded-lg border border-arcade-700 text-center">
              <span class="text-neon-yellow font-bold block mb-1">Enter / Phím 5</span>
              <span class="text-[11px] text-slate-400">Chọn / Hành động (OK)</span>
            </div>
            <div class="p-3 bg-arcade-800 rounded-lg border border-arcade-700 text-center">
              <span class="text-neon-pink font-bold block mb-1">Q / W hoặc F1 / F2</span>
              <span class="text-[11px] text-slate-400">Phím mềm Trái / Phải</span>
            </div>
            <div class="p-3 bg-arcade-800 rounded-lg border border-arcade-700 text-center">
              <span class="text-neon-green font-bold block mb-1">Chạm Màn Hình</span>
              <span class="text-[11px] text-slate-400">Bàn phím ảo trên Mobile</span>
            </div>
          </div>
        </div>

        <!-- Related Games -->
        {relatedGames.length > 0 && (
          <div>
            <h2 class="text-lg font-black text-slate-100 mb-4">Game Cùng Thể Loại</h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {relatedGames.map((rel) => (
                <a
                  href={`/game/${rel.slug}`}
                  class="flex items-center gap-3 p-3 bg-arcade-900 border border-arcade-800 hover:border-neon-cyan/50 rounded-xl transition-all group"
                >
                  <div class="w-12 h-12 rounded-lg bg-arcade-950 overflow-hidden flex-shrink-0">
                    {rel.cover_url ? (
                      <img src={rel.cover_url} alt={rel.name} class="w-full h-full object-cover" />
                    ) : (
                      <span class="w-full h-full flex items-center justify-center text-sm">🎮</span>
                    )}
                  </div>
                  <div class="overflow-hidden">
                    <h3 class="font-bold text-xs text-slate-200 group-hover:text-neon-cyan truncate">
                      {rel.name}
                    </h3>
                    <p class="text-[10px] text-slate-400 truncate mt-0.5">{rel.developer}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
