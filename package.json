{
  "name": "game-tuoi-tho-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Nền tảng lưu trữ, quản lý và chơi game Java ME (J2ME) đa thiết bị",
  "scripts": {
    "start": "pnpm --filter @gametuoitho/api start",
    "dev": "pnpm --filter @gametuoitho/api dev",
    "dev:api": "pnpm --filter @gametuoitho/api dev",
    "dev:web": "pnpm --filter @gametuoitho/web dev",
    "build": "pnpm --filter \"@gametuoitho/*\" build",
    "build:web": "pnpm --filter @gametuoitho/web build",
    "build:start": "pnpm build && pnpm start",
    "restart": "pnpm build && pnpm start",
    "test": "pnpm --filter \"@gametuoitho/*\" test && pnpm test:deploy && node --test tests/source-catalog.test.mjs",
    "lint": "pnpm --filter \"@gametuoitho/*\" lint",
    "cf:build": "node scripts/cf-build-web.mjs",
    "cf:dev": "pnpm cf:build && pnpm --filter @gametuoitho/api cf:migrate:local && pnpm --filter @gametuoitho/api cf:seed:local && pnpm --filter @gametuoitho/api cf:dev",
    "cf:migrate": "pnpm --filter @gametuoitho/api cf:migrate",
    "cf:seed": "pnpm --filter @gametuoitho/api cf:seed",
    "cf:deploy": "pnpm cf:build && pnpm --filter @gametuoitho/api cf:deploy",
    "cf:deploy:token": "node scripts/cf-deploy-token.mjs",
    "test:deploy": "node --test tests/deploy-token.test.mjs tests/deploy-bat.test.mjs",
    "catalog:update": "node scripts/update-source-catalog.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
