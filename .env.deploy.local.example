# Copy to .env.deploy.local at the project root. Fill in VS Code, never in chat.
# Cloudflare account and API token: create/copy from the web dashboard.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Create this Worker with the Hello World template on the dashboard first.
WORKER_NAME=gametuoitho

# Existing D1 created on the dashboard. Use its actual UUID and name.
D1_DATABASE_ID=
D1_DATABASE_NAME=gametuoitho-d1

# PRIVATE Tigris Standard bucket and its read/write/list/delete access key.
TIGRIS_BUCKET=
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# Optional: blank preserves an existing JWT secret, or generates one on first deploy.
JWT_SECRET=
GOOGLE_CLIENT_ID=
